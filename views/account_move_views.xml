<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_move_form_vat_simpl" model="ir.ui.view">
        <field name="name">account.move.form.vat.simpl</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">

                <page string="TVA Maroc">

                    <group>

                        <field name="vat_return_id"/>

                        <field name="vat_due_date"/>

                        <field name="vat_processed"/>

                        <field name="vat_payment_regime"/>

                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>