<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_company_form_vat_simpl" model="ir.ui.view">
        <field name="name">res.company.form.vat.simpl</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">

                <page string="TVA Maroc">

                    <group string="Paramètres TVA">

                        <field name="vat_regime"/>

                        <field name="vat_periodicity"/>

                        <field name="vat_prorata"/>

                        <field name="cash_payment_limit"/>

                    </group>

                    <group string="SIMPL">

                        <field name="simpl_username"/>

                        <field name="simpl_reference"/>

                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>