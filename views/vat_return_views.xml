<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_vat_return_tree" model="ir.ui.view">
        <field name="name">l10n.ma.vat.return.tree</field>
        <field name="model">l10n.ma.vat.return</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="regime"/>
                <field name="periodicity"/>
                <field name="vat_due"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_vat_return_form" model="ir.ui.view">
        <field name="name">l10n.ma.vat.return.form</field>
        <field name="model">l10n.ma.vat.return</field>
        <field name="arch" type="xml">

            <form>

                <header>

                     <button name="action_prepare"
                            string="Préparer"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_check"
                            string="Contrôler"
                            type="object"
                            invisible="state != 'prepared'"/>

                    <button name="action_validate"
                            string="Valider"
                            type="object"
                            class="btn-success"
                            invisible="state != 'checked'"/>
                     <button name="action_export_xml"
                            string="Exporter XML"
                            type="object"
                            class="btn-primary"
                             invisible="state != 'validated'"/>  

                    <button
                             name="action_export_excel"
                             string="Exporter Excel"
                             type="object"
                             class="btn-secondary"
                            invisible="state != 'validated'"/>  
                    <button
                             name="action_export_pdf"
                             string="Exporter PDF"
                             type="object"
                             class="btn-info"
                             invisible="state != 'validated'"/>                      
                     <button name="action_submit"
                             string="Déposer"
                             type="object"
                             invisible="state != 'validated'"/>

                    <button name="action_cancel"
                             string="Annuler"
                             type="object"
                            invisible="state == 'cancel'"/>

                    <button name="action_reset_to_draft"
                            string="Remettre en brouillon"
                            type="object"
                             invisible="state == 'draft'"/>

                    <field name="state" widget="statusbar"
                         statusbar_visible="draft,prepared,checked,validated,submitted,cancel"/> 


                </header>

                <sheet>

                    <group>

                        <group>

                            <field name="name"/>

                            <field name="company_id"/>

                            <field name="currency_id" invisible="1"/>

                        </group>

                        <group>

                            <field name="period_start"/>

                            <field name="period_end"/>

                            <field name="regime"/>

                            <field name="periodicity"/>

                        </group>

                    </group>

                    <notebook>


                        <page string="Totaux TVA">

                            <group>

                                <field name="vat_collected" readonly="1"/>

                                <field name="vat_deductible" readonly="1"/>

                                <field name="vat_credit" readonly="1"/>

                                <field name="vat_due" readonly="1"/>

                            </group>

                        </page>

                        <page string="Lignes TVA">

                            <field name="line_ids">

                                <list editable="bottom">

                                    <field name="sequence"/>

                                    <field name="name"/>

                                    <field name="line_type"/>

                                    <field name="tax_rate"/>

                                    <field name="base_amount"/>

                                    <field name="vat_amount"/>

                                </list>

                            </field>

                        </page>

                        <page string="Déductions">

                            <field name="deduction_line_ids">

                                <list editable="bottom">

                                    <field name="invoice_number"/>

                                    <field name="partner_id"/>

                                    <field name="invoice_date"/>

                                    <field name="payment_date"/>

                                    <field name="amount_untaxed"/>

                                    <field name="tax_amount"/>

                                    <field name="total_amount"/>

                                </list>

                            </field>

                        </page>

                        <page string="Historique">

                            <field name="history_ids">

                                <list>

                                    <field name="action"/>

                                    <field name="user_id"/>

                                    <field name="action_date"/>

                                    <field name="state"/>

                                    <field name="description"/>

                                </list>

                            </field>

                        </page>

                        <page string="Documents">

                            <group>

                                <field name="xml_file" filename="xml_filename"/>
                                <field name="xml_filename" invisible="1"/>

                                <field name="excel_file" filename="excel_filename"/>
                                <field name="excel_filename" invisible="1"/>

                                <field name="pdf_file" filename="pdf_filename"/>
                                <field name="pdf_filename" invisible="1"/>

                            </group>

                        </page>

                        <page string="Observations">

                            <field name="note"/>

                        </page>

                    </notebook>

                    <group>

                        <group>

                            <field name="validation_date" readonly="1"/>

                        </group>

                        <group>

                            <field name="validated_by" readonly="1"/>

                        </group>

                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>

    <record id="action_vat_return" model="ir.actions.act_window">

        <field name="name">Déclarations TVA</field>

        <field name="res_model">l10n.ma.vat.return</field>

        <field name="view_mode">list,form</field>

    </record>


    <menuitem
        id="menu_vat_root"
        name="Déclaration TVA Maroc"
        sequence="10"/>

    <menuitem
        id="menu_vat_return"
        name="Déclarations TVA"
        parent="menu_vat_root"
        action="action_vat_return"
        sequence="10"/>

</odoo>